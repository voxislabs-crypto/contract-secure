// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contract {
  id           String    @id @default(cuid())
  title        String
  pdfUrl       String?   // where the final stamped PDF will live
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  signers      Signer[]
  auditLogs    AuditLog[]
}

model Signer {
  id          String    @id @default(cuid())
  contractId  String
  phone       String
  email       String?
  otpVerified Boolean   @default(false)
  signature   String?   // base64 path or storage key
  createdAt   DateTime  @default(now())
  contract    Contract  @relation(fields: [contractId], references: [id])
}

model AuditLog {
  id          String    @id @default(cuid())
  contractId  String
  event       String
  meta        Json?
  createdAt   DateTime  @default(now())
  contract    Contract  @relation(fields: [contractId], references: [id])
}
